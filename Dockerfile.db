# Dockerfile.db
FROM postgres:16.9

# Устанавливаем необходимые пакеты для PostgreSQL (Debian-based)
# gettext-base нужен для некоторых утилит, postgresql-client для подключения
RUN apt-get update && apt-get install -y --no-install-recommends \
    gettext-base \
    postgresql-client \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

